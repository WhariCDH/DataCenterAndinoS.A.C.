        "id": "74a40020e848ea59",
        "type": "function",
        "z": "c7747b3a3fa4731b",
        "name": "function 1",
        "func": "// DataCenter Andino S.A.C. - TA3 - Clasificación corregida según guía\n// Umbrales configurables (exigido por la guía)\nconst UMBRALES = {\n    TEMP_ADVERTENCIA: 28,\n    TEMP_CRITICO: 30,\n    HUM_ADVERTENCIA: 70, // extra - justificado en informe\n    HUM_CRITICO: 80\n};\n\nlet temp = msg.payload.temp;\nlet hum = msg.payload.hum;\nlet luz = msg.payload.luz_pct;\n\nlet estado = \"normal\";\nlet motivo = [];\nlet info_luz = \"OK\";\n\n// Lógica principal = SOLO TEMPERATURA (según enunciado)\nif (temp >= UMBRALES.TEMP_CRITICO) {\n    estado = \"critica\"; // usa \"critica\" como dice la guía\n    motivo.push(`Temp crítica: ${temp}°C >= ${UMBRALES.TEMP_CRITICO}°C`);\n} else if (temp >= UMBRALES.TEMP_ADVERTENCIA) {\n    estado = \"advertencia\";\n    motivo.push(`Temp advertencia: ${temp}°C en rango [28 - 30)°C`);\n}\n\n// Humedad como variable extra (justificada)\nif (hum >= UMBRALES.HUM_CRITICO) {\n    motivo.push(`Humedad alta crítica: ${hum}%`);\n} else if (hum >= UMBRALES.HUM_ADVERTENCIA) {\n    motivo.push(`Humedad alta: ${hum}% - riesgo condensación`);\n}\n\n// Luz = SOLO informativa, NO dispara crítico (corrección punto 2)\nif (luz < 20) {\n    info_luz = `luz encendida fuera de ventana de mantenimiento (${luz}%) - informativo`;\n}\n\nmsg.payload.estado = estado;\nmsg.payload.motivo = motivo;\nmsg.payload.info_luz = info_luz;\nmsg.payload.umbrales_usados = UMBRALES;\n\nreturn msg;",
